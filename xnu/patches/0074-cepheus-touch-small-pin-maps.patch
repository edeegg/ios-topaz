+    vm_offset_t bank = 0;
+    uint32_t off = 0;
+    switch (pin) {
+    case 55: bank=st.gpio_i2c; break;
+    case 56: bank=st.gpio_i2c; off=0x1000; break;
+    case 12: bank=st.gpio_reset; break;
+    case 84: bank=st.gpio_power; break;
+    case 122: bank=st.gpio_irq; break;
+    default: return;
+    }
+    if (!bank) return;
+    uint32_t cfg=touch_rd(bank,off);
+    if (out) touch_wr(bank,off+4,touch_rd(bank,off+4)|2u);
+    cfg &= ~0x3ffu;
+    cfg |= (mux<<2) | pull | (drive<<6) | (out ? 0x200u : 0u);
+    touch_wr(bank,off,cfg);
 }
 
